# Feishu Bot (required)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# Claude (optional — omit to use Claude CLI subscription)
# ANTHROPIC_API_KEY=sk-ant-...

# Session manager (optional — defaults shown)
SESSION_TIMEOUT_HOURS=50
STREAM_UPDATE_INTERVAL=1.5

# Logging (optional — DEBUG | INFO | WARNING | ERROR; default INFO)
LOG_LEVEL=INFO
